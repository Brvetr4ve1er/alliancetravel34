# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.bak

# Node (if/when build is added)
node_modules/
dist/
.cache/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Env
.env
.env.local
.env.*.local

# Build artifacts
*.tmp
*.log

# Image-pipeline scratch (Pexels candidates, contact-sheet montages)
_imgtmp/

# Local-only
.claude/launch.json

# One-shot script backups — local revert safety, never committed
scripts/_*-backup/

# Editor metadata — never commit
.obsidian/
.vercel
.env*

# Supplier B2B rate sheets — CONFIDENTIAL, never commit. 77 MB of wholesale
# brochures carrying supplier names and commission amounts; docs/PROJECT-BIBLE.md
# classes those as internal-only and this repo is public. The owner drops the PDFs
# here locally and a dev/AI reads them from disk; nothing in the build touches this
# directory (tools/build.mjs reads only data/, tools/ and site/).
source of truth/

# Local agent/browser working dirs — session logs & paused audit scratch.
# Never commit: .playwright-mcp accumulates real browser-session console/page
# dumps on every automated run; this repo is public.
.playwright-mcp/
.security-hardening/

# Verification screenshots dropped at the repo root by browser-automation runs.
# This repo is PUBLIC and a broad `git add -A` has swept stray local files into
# a commit before (see the orphan-page gate in tools/build.mjs).
/*.png
/*.jpg
/*.jpeg
/*.webp
